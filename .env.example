# For local development with SQLite (default)
# Leave DATABASE_URL empty to use SQLite

# For production with PostgreSQL
# Get a free PostgreSQL database from:
# - ElephantSQL: https://www.elephantsql.com
# - Supabase: https://supabase.com
# - Neon: https://neon.tech

DATABASE_URL=postgresql://user:password@host:port/database

# Generate a random secret key with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_random_secret

# Local PostgreSQL (optional, for local development with PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mywebsite
DB_USER=postgres
DB_PASSWORD=replace_with_your_postgres_password
